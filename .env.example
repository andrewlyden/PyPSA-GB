# Copy to .env (gitignored) and fill in what you need. Nothing here is required
# for the default Test_Market scenario.

# ENTSO-E Transparency Platform token, used only by scripts/interconnectors/fetch_entsoe_prices.py
# (historical day-ahead prices). Request one at https://transparency.entsoe.eu/
ENTSOE_API_TOKEN=

# Maintainers only: Zenodo personal access token (scopes deposit:write, deposit:actions)
# for uploading the PyPSA-GB input data bundle.
ZENODO_TOKEN=
